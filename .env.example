# AWS 설정 (번역 서비스용)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# OpenAI 설정 (음성 인식용)
OPENAI_KEY=your_openai_api_key_here

# 관리자 계정 설정 (초기 설정용)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123!
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=System Administrator

# 세션 쿠키 HMAC 서명 비밀키 (미설정 시 자동 생성, 서버 재시작 시 세션 무효화)
SESSION_SECRET=your_session_secret_here

# 뷰어 SSE 브로드캐스트 서버 포트 (ISSUE-30, 기본 8766)
SSE_PORT=8766

# QR 코드에 들어갈 뷰어 base URL (ISSUE-32)
# 운영에서는 외부 기기가 접근 가능한 주소로 반드시 설정
# (예: https://captions.example.com 또는 http://<서버 IP>:8766)
# 미설정 시 http://localhost:8766 — 같은 기기에서만 열림
VIEWER_BASE_URL=

# 선택적 설정
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
