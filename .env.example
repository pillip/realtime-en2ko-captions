# AWS 설정 (번역 서비스용)
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# OpenAI 설정 (음성 인식용)
OPENAI_KEY=your_openai_api_key_here

# 관리자 계정 설정 (초기 설정용)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123!
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=System Administrator

# 세션 쿠키 HMAC 서명 비밀키 — **운영 권장** (ISSUE-55)
#
# 미설정이면 컨테이너 기동마다 무작위로 생성된다. 자동 생성 값은 프로세스
# 전체가 공유하므로(Streamlit·WS·SSE 스레드가 같은 os.environ 을 읽는다)
# **그 실행 중에는 정상 동작한다.** 문제가 되는 것은 재시작이다 — 이전에 발급된
# 쿠키가 전부 무효가 되어 오퍼레이터가 다시 로그인해야 세션을 열 수 있고,
# ISSUE-55 이후로는 그 재로그인이 WebSocket 인증까지 함께 가둔다.
#
# 다만 재시작 후에는 lazy-start(ISSUE-71) 때문에 어차피 오퍼레이터가 :8501 을
# 한 번 열어야 하므로, 실무상 재로그인 한 단계가 거기에 합쳐진다.
#
# 생성: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=your_session_secret_here

# 뷰어 SSE 브로드캐스트 서버 포트 (ISSUE-30, 기본 8766)
SSE_PORT=8766

# QR 코드에 들어갈 뷰어 base URL (ISSUE-32)
# 운영에서는 외부 기기가 접근 가능한 주소로 반드시 설정
# (예: https://captions.example.com 또는 http://<서버 IP>:8766)
# 미설정 시 http://localhost:8766 — 같은 기기에서만 열림
VIEWER_BASE_URL=

# 선택적 설정
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
